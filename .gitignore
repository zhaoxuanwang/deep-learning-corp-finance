*.aux
*.log
*.tex
*.bib
*.html
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.bak
*.xdv
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.typ
*_files/
.quarto/
