# --- Project Specific Exclusions ---
archive/
notebooks/
.venv/
.DS_Store
experiments/
production/
notes/
.cache/
configs/pipelines/

# --- Python Standard Exclusions ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache

# --- IDE Settings ---
.idea/
.vscode/
*.swp
.claude/
.agent/

# --- Data & Results ---
*.npz
*.csv
*.csv.gz
*.png
*.svg
outputs/

# --- Model Checkpoints ---
*.keras
results/
checkpoints/

# --- Quarto / LaTeX Generated Files ---
